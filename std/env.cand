// C& Programming Language — Environment & .env Configuration Library (std/env.cand)

extern "C" fn cand_load_env_file(path: string) -> int
extern "C" fn getenv(name: string) -> string

pub fn load_env(path: string) -> int {
    return cand_load_env_file(path);
}

pub fn get_env_var(name: string) -> string {
    return getenv(name);
}
