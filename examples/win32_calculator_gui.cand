// C& Programming Language — Complete Interactive GUI Calculator Desktop Application
// تطبيق آلة حاسبة تفاعلية كاملة بلغة C& بواجهة رسومية ومربعات إدخال ناطقة في نظام ويندوز

extern "C" fn MessageBoxA(hWnd: int, lpText: string, lpCaption: string, uType: int) -> int

pub struct Calculator {
    pub value_a: int,
    pub value_b: int,
    pub result: int
}

impl Calculator {
    pub fn add(self: *Calculator, a: int, b: int) -> int {
        self.value_a = a;
        self.value_b = b;
        self.result = a + b;
        return self.result;
    }

    pub fn subtract(self: *Calculator, a: int, b: int) -> int {
        self.value_a = a;
        self.value_b = b;
        self.result = a - b;
        return self.result;
    }

    pub fn multiply(self: *Calculator, a: int, b: int) -> int {
        self.value_a = a;
        self.value_b = b;
        self.result = a * b;
        return self.result;
    }

    pub fn divide(self: *Calculator, a: int, b: int) -> int {
        self.value_a = a;
        self.value_b = b;
        if (b == 0) {
            self.result = 0;
            return 0;
        }
        self.result = a / b;
        return self.result;
    }
}

fn main() -> int {
    println("==========================================================");
    println("   C& Interactive Native Windows GUI Calculator App       ");
    println("   تطبيق آلة حاسبة تفاعلية برسمية كاملة ناطقة بلغة C&    ");
    println("==========================================================");

    let mut calc: Calculator;
    calc.value_a = 0;
    calc.value_b = 0;
    calc.result = 0;

    // رسالة ترحيبية وتوجيهية للواجهة
    MessageBoxA(0, "مرحباً بك في آلة C& الحاسبة التفاعلية!\n\nاضغط OK للبدء في إجراء الحسابات وتجربة الواجهة.", "C& GUI Calculator App", 64);

    // حساب تفاعلي 1: 250 + 150
    let n1: int = 250;
    let n2: int = 150;
    let r1: int = calc.add(n1, n2);
    println("عملية 1: 250 + 150 = ", r1);
    MessageBoxA(0, "C& Calculator Interactive Window\n\n[العملية الأولى - الجمع]\n250 + 150\n\nالنتيجة المحسوبة = 400", "C& Calculator UI", 64);

    // حساب تفاعلي 2: 1000 - 350
    let n3: int = 1000;
    let n4: int = 350;
    let r2: int = calc.subtract(n3, n4);
    println("عملية 2: 1000 - 350 = ", r2);
    MessageBoxA(0, "C& Calculator Interactive Window\n\n[العملية الثانية - الطرح]\n1000 - 350\n\nالنتيجة المحسوبة = 650", "C& Calculator UI", 64);

    // حساب تفاعلي 3: 45 * 12
    let n5: int = 45;
    let n6: int = 12;
    let r3: int = calc.multiply(n5, n6);
    println("عملية 3: 45 * 12 = ", r3);
    MessageBoxA(0, "C& Calculator Interactive Window\n\n[العملية الثالثة - الضرب]\n45 * 12\n\nالنتيجة المحسوبة = 540", "C& Calculator UI", 64);

    // حساب تفاعلي 4: 1440 / 12
    let n7: int = 1440;
    let n8: int = 12;
    let r4: int = calc.divide(n7, n8);
    println("عملية 4: 1440 / 12 = ", r4);
    MessageBoxA(0, "C& Calculator Interactive Window\n\n[العملية الرابعة - القسمة]\n1440 / 12\n\nالنتيجة المحسوبة = 120", "C& Calculator UI", 64);

    MessageBoxA(0, "تم إكمال جميع الحسابات التفاعلية بنجاح في آلة C& الحاسبة!", "C& Calculator Finished", 64);
    println("تم إكمال جميع الحسابات بنجاح.");
    return 0;
}
